# Required: generate transcription (Whisper) and feedback from the OpenAI API
# https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# Public base URL of the deployed site (used for canonical/OG/sitemap URLs).
# Example: https://mockoff.onrender.com
NEXT_PUBLIC_SITE_URL=

# Optional: rate-limit the public demo using Upstash serverless Redis.
# https://upstash.com/blog/upstash-ratelimit
# If either value is missing, rate limiting is disabled automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
